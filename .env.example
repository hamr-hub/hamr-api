PORT=8090
# JWT_SECRET must be >= 32 bytes (HS256 minimum). The gateway refuses
# to start if this var is missing or shorter. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-this-is-only-a-placeholder-not-secret-32b
ACCOUNT_SERVICE_URL=http://hamr-account-api:8080
APP_SERVICE_URL=http://hamr-app-api:8081
JIABU_SERVICE_URL=http://hamr-jiabu-api:8082
RATE_LIMIT_PER_MINUTE=60
# Comma-separated list of allowed CORS origins.
# Empty list → deny-all (safe default). Production must set this.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://hamr.top
